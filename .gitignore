# Include project data, databases, and outputs, including files ignored by
# the parent repository (videos, NumPy arrays, SQLite databases, archives).
!/data/
!/data/**
!/database/
!/database/**
!/outputs/
!/outputs/**

# Keep local environments, caches, and credentials out of Git.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
*.pem
*.key
